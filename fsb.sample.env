# Copy to fsb.env. Never commit fsb.env or real credentials.
API_ID=
API_HASH=
BOT_TOKEN=
LOG_CHANNEL=
ALLOWED_USERS=7513979260
HOST=https://your-stream-domain.example
PORT=8080
# Generate locally: openssl rand -hex 32
SIGNING_SECRET=
# Optional separate random key, trusted website BACKEND only. Empty disables mint API.
MINT_API_KEY=
LINK_TTL_SECONDS=14400
# Store connection secret only locally, not in source/chat.
MONGODB_URI=
MONGODB_DATABASE=spark_stream
HASH_LENGTH=32
MAX_ACTIVE_STREAMS=8
REQUESTS_PER_MINUTE=120
REQUEST_BURST=30
STREAM_CONCURRENCY=2
STREAM_BUFFER_COUNT=4
STREAM_TIMEOUT_SEC=30
STREAM_MAX_RETRIES=3
DEV=false
USE_PUBLIC_IP=false
USE_SESSION_FILE=true
# Do not put user-session credentials in source or chat.
